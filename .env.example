# ── Database ──────────────────────────────────────────────
# Supabase: Project → Connect → "Transaction pooler" (port 6543). Works locally and on Vercel.
# DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Local PostgreSQL alternative (create it once with: createdb -U postgres pulse_sales):
DATABASE_URL=postgres://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/pulse_sales

# Public URL used in emails (invites, password resets). On Vercel: https://<your-app>.vercel.app
APP_URL=http://localhost:3000

# Password given to every demo account created by `npm run db:seed`.
# The default only works against a local database; set your own strong value for Supabase.
SEED_PASSWORD=pulse-demo-123

# ── Optional: Stripe (leave empty to use local billing mode) ──
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=
