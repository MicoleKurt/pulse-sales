# ── Database (local PostgreSQL 16) ────────────────────────
# Create the database once:  createdb -U postgres pulse_sales
DATABASE_URL=postgres://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/pulse_sales

# Public URL used in emails (invites, password resets)
APP_URL=http://localhost:3000

# Password given to every demo account created by `npm run db:seed` (local test data only)
SEED_PASSWORD=pulse-demo-123

# ── Optional: Stripe (leave empty to use local billing mode) ──
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=
